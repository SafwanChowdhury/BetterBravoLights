<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Version>1.0.0</Version>
    <Authors>Royston Shufflebotham &lt;royston@shufflebotham.org&gt;</Authors>
    <Product>Better Bravo Lights</Product>
    <Copyright>(C) 2021-2026 Royston Shufflebotham and contributors</Copyright>
    <PackageId>BetterBravoLights</PackageId>
    <AssemblyName>BetterBravoLights</AssemblyName>
    <ApplicationIcon>Resources\TrayIcon.ico</ApplicationIcon>
    <!-- The SimConnect native library is x64 only -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Resources\Bulb.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Xaml.Behaviors.Wpf" Version="1.1.135" />
    <PackageReference Include="NLog" Version="5.3.4" />
    <PackageReference Include="sly" Version="2.8.0" />
  </ItemGroup>

  <!--
    SimConnect is vendored from the MSFS SDK so that the app can be built without the SDK installed.
    The v11 managed wrapper talks to both MSFS 2020 and MSFS 2024.
  -->
  <ItemGroup>
    <Reference Include="Microsoft.FlightSimulator.SimConnect">
      <HintPath>..\lib\SimConnect\Microsoft.FlightSimulator.SimConnect.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Include="..\lib\SimConnect\SimConnect.dll" Link="SimConnect.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!--
    The prebuilt LVar WASM module. Rebuild it with the MSFS SDK (see README) if WasmModule.cpp changes.
  -->
  <ItemGroup>
    <None Include="..\WasmModule\Prebuilt\better-bravo-lights-lvar-module\**\*" LinkBase="Packages\better-bravo-lights-lvar-module">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BravoLights.Common\BravoLights.Common.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\Bulb.png" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <None Update="Templates\**\*.bblprofile">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="KnownSimVars.csv">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="LICENSES.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\BetterBravoLights.exe.nlog" Link="BetterBravoLights.exe.nlog">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
