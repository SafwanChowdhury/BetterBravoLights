<Application x:Class="BravoLights.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:BravoLights.UI"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="UI/Themes/Dark.xaml" />
                <ResourceDictionary Source="UI/Themes/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <ui:StatusBrushConverter x:Key="StatusBrush" />
            <ui:LightBrushConverter x:Key="LightBrush" />
            <ui:BoolToVisibilityConverter x:Key="BoolToVis" />
            <ui:BoolToVisibilityConverter x:Key="InvBoolToVis" Invert="True" />
            <ui:NullToVisibilityConverter x:Key="NullToVis" />
            <ui:NullToVisibilityConverter x:Key="InvNullToVis" Invert="True" />
            <ui:InverseBoolConverter x:Key="InverseBool" />
            <ui:ZeroToVisibilityConverter x:Key="ZeroToVis" />
            <ui:ZeroToVisibilityConverter x:Key="NonZeroToVis" Invert="True" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
