<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Light palette: soft off-white with an indigo accent. Keys must match Dark.xaml. -->

    <Color x:Key="BgColor">#FFF5F6F8</Color>
    <Color x:Key="TextColor">#FF151821</Color>
    <Color x:Key="AccentColor">#FF4C5FD5</Color>

    <SolidColorBrush x:Key="BgBrush" Color="#FFF5F6F8" />
    <SolidColorBrush x:Key="NavBrush" Color="#FFF5F6F8" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Surface2Brush" Color="#FFF0F2F5" />
    <SolidColorBrush x:Key="Surface3Brush" Color="#FFE6E9EE" />
    <SolidColorBrush x:Key="BorderBrush" Color="#FFE5E8ED" />
