<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Dark palette: cool graphite with a soft periwinkle accent. Keys must match Light.xaml. -->

    <Color x:Key="BgColor">#FF0F1115</Color>
    <Color x:Key="TextColor">#FFE9ECF1</Color>
    <Color x:Key="AccentColor">#FF8B9CFF</Color>

    <SolidColorBrush x:Key="BgBrush" Color="#FF0F1115" />
    <SolidColorBrush x:Key="NavBrush" Color="#FF0F1115" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FF171A20" />
    <SolidColorBrush x:Key="Surface2Brush" Color="#FF1E222A" />
    <SolidColorBrush x:Key="Surface3Brush" Color="#FF282D36" />
    <SolidColorBrush x:Key="BorderBrush" Color="#FF242932" />
    <SolidColorBrush x:Key="InputBrush" Color="#FF1B1F26" />

    <SolidColorBrush x:Key="TextBrush" Color="#FFE9ECF1" />
    <SolidColorBrush x:Key="TextDimBrush" Color="#FF9097A3" />
    <SolidColorBrush x:Key="TextFaintBrush" Color="#FF5E6573" />

    <SolidColorBrush x:Key="AccentBrush" Color="#FF8B9CFF" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#FFA5B3FF" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#248B9CFF" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#FFA5B3FF" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FF0E1020" />

    <SolidColorBrush x:Key="SuccessBrush" Color="#FF4ADE80" />
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="#1F4ADE80" />
    <SolidColorBrush x:Key="WarningBrush" Color="#FFFBBF24" />
    <SolidColorBrush x:Key="WarningSoftBrush" Color="#1FFBBF24" />
    <SolidColorBrush x:Key="DangerBrush" Color="#FFF87171" />
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#1FF87171" />

    <SolidColorBrush x:Key="HoverBrush" Color="#0EFFFFFF" />
    <SolidColorBrush x:Key="PressedBrush" Color="#18FFFFFF" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#FF2C313B" />
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#FF3B414D" />

    <!-- An unlit light shown on a page (e.g. the dots in the profile editor) -->
    <SolidColorBrush x:Key="LightOffBrush" Color="#FF2B3039" />

    <!-- The on-screen Bravo looks like the real (black) hardware in both themes -->
    <SolidColorBrush x:Key="DeviceBrush" Color="#FF0B0D10" />
    <SolidColorBrush x:Key="DeviceBorderBrush" Color="#FF20242C" />
    <SolidColorBrush x:Key="DeviceKeyBrush" Color="#FF191C22" />
    <SolidColorBrush x:Key="DeviceLabelBrush" Color="#FF5A606D" />
    <SolidColorBrush x:Key="LitRedBrush" Color="#FFFF5A4E" />
    <SolidColorBrush x:Key="LitAmberBrush" Color="#FFFFB224" />
    <SolidColorBrush x:Key="LitGreenBrush" Color="#FF45E08A" />
</ResourceDictionary>
