<Window x:Class="BravoLights.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:BravoLights.UI.ViewModels"
        xmlns:views="clr-namespace:BravoLights.UI.Views"
        Style="{StaticResource AppWindow}"
        Title="{Binding Title}"
        Width="1240" Height="840" MinWidth="1000" MinHeight="660"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Resources/Bulb.png">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProfilesViewModel}">
            <views:ProfilesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ScannerViewModel}">
            <views:ScannerView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>

        <Style x:Key="StatusDot" TargetType="Ellipse">
            <Setter Property="Width" Value="7" />
            <Setter Property="Height" Value="7" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="StatusText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="228" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Navigation rail -->
        <DockPanel Background="{DynamicResource NavBrush}">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="24,26,24,28">
                <Border Width="30" Height="30" CornerRadius="9" Margin="0,0,12,0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#FF8B9CFF" Offset="0" />
                            <GradientStop Color="#FF5A6CE6" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <Ellipse Width="7" Height="7" Fill="#FFFFB224" Margin="-7,-7,0,0" />
                        <Ellipse Width="7" Height="7" Fill="#FF45E08A" Margin="7,7,0,0" />
                    </Grid>
                </Border>
                <TextBlock Text="Bravo Lights" FontFamily="{StaticResource DisplayFont}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>

            <!-- Bottom: live status and theme toggle -->
            <StackPanel DockPanel.Dock="Bottom" Margin="24,0,16,20" DataContext="{Binding Dashboard}">
                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <Ellipse Style="{StaticResource StatusDot}" Fill="{Binding SimStatusLevel, Converter={StaticResource StatusBrush}}" />
                    <TextBlock Style="{StaticResource StatusText}" Text="{Binding SimStatusText, StringFormat='Simulator · {0}'}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <Ellipse Style="{StaticResource StatusDot}" Fill="{Binding BravoStatusLevel, Converter={StaticResource StatusBrush}}" />
                    <TextBlock Style="{StaticResource StatusText}" Text="{Binding BravoStatusText, StringFormat='Bravo · {0}'}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <Ellipse Style="{StaticResource StatusDot}" Fill="{Binding ModuleStatusLevel, Converter={StaticResource StatusBrush}}" />
                    <TextBlock Style="{StaticResource StatusText}" Text="{Binding ModuleStatusText, StringFormat='LVars · {0}'}" />
                </StackPanel>

                <DockPanel Margin="0,16,0,0">
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}"
                            Command="{Binding DataContext.ToggleThemeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            ToolTip="Switch between light and dark"
                            Content="{Binding DataContext.ThemeIcon, RelativeSource={RelativeSource AncestorType=Window}}" />
                    <TextBlock Style="{StaticResource Faint}" VerticalAlignment="Center"
                               Text="{Binding DataContext.Version, RelativeSource={RelativeSource AncestorType=Window}, StringFormat='v{0}'}" />
                </DockPanel>
            </StackPanel>

            <StackPanel>
                <RadioButton Style="{StaticResource NavItem}" GroupName="nav" IsChecked="{Binding IsDashboard}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE80F;" Style="{StaticResource Icon}" Margin="0,0,14,0" />
                        <TextBlock Text="Dashboard" />
                    </StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource NavItem}" GroupName="nav" IsChecked="{Binding IsProfiles}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE709;" Style="{StaticResource Icon}" Margin="0,0,14,0" />
                        <TextBlock Text="Profiles" />
                    </StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource NavItem}" GroupName="nav" IsChecked="{Binding IsScanner}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" Margin="0,0,14,0" />
                        <TextBlock Text="Variables" />
                    </StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource NavItem}" GroupName="nav" IsChecked="{Binding IsSettings}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE713;" Style="{StaticResource Icon}" Margin="0,0,14,0" />
                        <TextBlock Text="Settings" />
                    </StackPanel>
                </RadioButton>
            </StackPanel>
        </DockPanel>

        <ContentControl Grid.Column="1" Content="{Binding CurrentContent}" Focusable="False" />
    </Grid>
</Window>
