<Window x:Class="BravoLights.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:BravoLights.UI.ViewModels"
        xmlns:views="clr-namespace:BravoLights.UI.Views"
        Style="{StaticResource AppWindow}"
        Title="{Binding Title}"
        Width="1180" Height="800" MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Resources/Bulb.png">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProfilesViewModel}">
            <views:ProfilesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ScannerViewModel}">
            <views:ScannerView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>

        <Style x:Key="StatusDot" TargetType="Ellipse">
            <Setter Property="Width" Value="8" />
            <Setter Property="Height" Value="8" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Side bar -->
        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="20,22,20,22" Orientation="Horizontal">
                    <Border Width="34" Height="34" CornerRadius="8" Background="{StaticResource Surface3Brush}" Margin="0,0,10,0">
                        <Grid>
                            <Ellipse Width="14" Height="14" Fill="{StaticResource LitAmberBrush}" Margin="-8,-8,0,0" />
                            <Ellipse Width="10" Height="10" Fill="{StaticResource LitGreenBrush}" Margin="12,10,0,0" />
                        </Grid>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Better Bravo" FontWeight="SemiBold" FontSize="14" />
                        <TextBlock Text="LIGHTS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextDimBrush}" />
                    </StackPanel>
                </StackPanel>

                <!-- Live status at the bottom of the side bar -->
                <StackPanel DockPanel.Dock="Bottom" Margin="20,12,20,18" DataContext="{Binding Dashboard}">
                    <StackPanel Orientation="Horizontal" Margin="0,3">
                        <Ellipse Style="{StaticResource StatusDot}" Fill="{Binding SimStatusLevel, Converter={StaticResource StatusBrush}}" />
                        <TextBlock Text="{Binding SimStatusText, StringFormat='Sim: {0}'}" Foreground="{StaticResource TextDimBrush}" FontSize="12" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,3">
                        <Ellipse Style="{StaticResource StatusDot}" Fill="{Binding BravoStatusLevel, Converter={StaticResource StatusBrush}}" />
                        <TextBlock Text="{Binding BravoStatusText, StringFormat='Bravo: {0}'}" Foreground="{StaticResource TextDimBrush}" FontSize="12" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,3">
                        <Ellipse Style="{StaticResource StatusDot}" Fill="{Binding ModuleStatusLevel, Converter={StaticResource StatusBrush}}" />
                        <TextBlock Text="{Binding ModuleStatusText, StringFormat='LVars: {0}'}" Foreground="{StaticResource TextDimBrush}" FontSize="12" />
                    </StackPanel>
                    <TextBlock Margin="0,10,0,0" Foreground="{StaticResource TextFaintBrush}" FontSize="11"
                               Text="{Binding DataContext.Version, RelativeSource={RelativeSource AncestorType=Window}, StringFormat='Version {0}'}" />
                </StackPanel>

                <StackPanel>
                    <RadioButton Style="{StaticResource NavItem}" GroupName="nav" IsChecked="{Binding IsDashboard}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" Margin="0,2,12,0" />
                            <TextBlock Text="Dashboard" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavItem}" GroupName="nav" IsChecked="{Binding IsProfiles}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE709;" FontFamily="Segoe MDL2 Assets" Margin="0,2,12,0" />
                            <TextBlock Text="Aircraft profiles" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavItem}" GroupName="nav" IsChecked="{Binding IsScanner}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" Margin="0,2,12,0" />
                            <TextBlock Text="Variable scanner" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavItem}" GroupName="nav" IsChecked="{Binding IsSettings}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" Margin="0,2,12,0" />
                            <TextBlock Text="Settings" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </DockPanel>
        </Border>

        <ContentControl Grid.Column="1" Content="{Binding CurrentContent}" Focusable="False" />
    </Grid>
</Window>
