<Window x:Class="BravoLights.UI.VariablePickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppWindow}"
        Title="Insert a variable" Width="720" Height="560" MinWidth="520" MinHeight="380"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="18">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Insert a variable" Style="{StaticResource H2}" />
            <TextBlock x:Name="SourceText" Style="{StaticResource Dim}" Margin="0,4,0,12" />
            <DockPanel Margin="0,0,0,10">
                <Border DockPanel.Dock="Right" Background="{StaticResource Surface2Brush}" CornerRadius="6" Margin="10,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="LVarsTab" Style="{StaticResource SegmentItem}" GroupName="kind" IsChecked="True" Checked="Kind_Checked" Content="L: variables" />
                        <RadioButton x:Name="SimVarsTab" Style="{StaticResource SegmentItem}" GroupName="kind" Checked="Kind_Checked" Content="A: variables" />
                    </StackPanel>
                </Border>
                <Grid>
                    <TextBox x:Name="SearchBox" TextChanged="SearchBox_TextChanged" PreviewKeyDown="SearchBox_PreviewKeyDown" />
                    <TextBlock Text="Search… (several words narrow the list)" Foreground="{StaticResource TextFaintBrush}" IsHitTestVisible="False" Margin="10,0,0,0"
                               VerticalAlignment="Center" Visibility="{Binding Text, ElementName=SearchBox, Converter={StaticResource InvNullToVis}}" />
                </Grid>
            </DockPanel>
        </StackPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Cancel" IsCancel="True" Margin="0,0,8,0" />
                <Button Content="Insert" IsDefault="True" Style="{StaticResource PrimaryButton}" Click="Insert_Click" MinWidth="80" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Insert as" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource TextDimBrush}" />
                <ComboBox x:Name="ComparisonBox" Width="170" SelectedIndex="1">
                    <ComboBoxItem Content="variable only" Tag="" />
                    <ComboBoxItem Content="… == 1" Tag=" == 1" />
                    <ComboBoxItem Content="… != 0" Tag=" != 0" />
                    <ComboBoxItem Content="… &gt; 0" Tag=" &gt; 0" />
                    <ComboBoxItem Content="… == 0" Tag=" == 0" />
                </ComboBox>
            </StackPanel>
        </DockPanel>

        <ListBox x:Name="ResultsList" MouseDoubleClick="ResultsList_MouseDoubleClick"
                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                 Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="4">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding Units}" Foreground="{StaticResource TextDimBrush}" FontSize="11.5" Margin="10,0,0,0" />
                            <TextBlock Text="{Binding Name}" FontFamily="{StaticResource MonoFont}" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                        <TextBlock Text="{Binding Description}" Foreground="{StaticResource TextDimBrush}" FontSize="11.5" TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding Description, Converter={StaticResource NullToVis}}" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
