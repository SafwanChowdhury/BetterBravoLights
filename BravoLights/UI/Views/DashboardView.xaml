<UserControl x:Class="BravoLights.UI.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:BravoLights.UI.ViewModels"
             xmlns:ui="clr-namespace:BravoLights.UI"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:DashboardViewModel}"
             d:DesignWidth="980" d:DesignHeight="800">
    <UserControl.Resources>
        <!-- A status card at the top of the dashboard -->
        <Style x:Key="StatusCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>

        <!-- A light on the on-screen Bravo -->
        <Style x:Key="LightTileButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
            <Setter Property="Command" Value="{Binding DataContext.SelectLightCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
            <Setter Property="CommandParameter" Value="{Binding}" />
            <Setter Property="ToolTip" Value="{Binding ToolTip}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="selection" CornerRadius="7" BorderThickness="2" BorderBrush="Transparent" Margin="-3" />
                            <Border x:Name="face" CornerRadius="5" BorderThickness="1" BorderBrush="#33000000">
                                <Border.Background>
                                    <MultiBinding Converter="{StaticResource LightBrush}">
                                        <Binding Path="Colour" />
                                        <Binding Path="IsLit" />
                                    </MultiBinding>
                                </Border.Background>
                                <Grid>
                                    <TextBlock x:Name="label" Text="{Binding Label}" TextWrapping="Wrap" TextAlignment="Center"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="4,2"
                                               FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource LightOffTextBrush}" />
                                    <Ellipse x:Name="errorDot" Width="7" Height="7" Fill="{StaticResource DangerBrush}" HorizontalAlignment="Right"
                                             VerticalAlignment="Top" Margin="0,4,4,0" Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />
                                </Grid>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsLit}" Value="True">
                                <Setter TargetName="label" Property="Foreground" Value="#E6000000" />
                                <Setter TargetName="face" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="14" ShadowDepth="0" Opacity="0.55" Color="White" />
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsUnconfigured}" Value="True">
                                <Setter TargetName="face" Property="Opacity" Value="0.55" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="selection" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="face" Property="BorderBrush" Value="{StaticResource TextFaintBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GearLightButton" TargetType="Button" BasedOn="{StaticResource LightTileButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Width="30" Height="30">
                            <Ellipse x:Name="selection" StrokeThickness="2" Stroke="Transparent" Margin="-3" />
                            <Ellipse x:Name="face" Stroke="#33000000">
                                <Ellipse.Fill>
                                    <MultiBinding Converter="{StaticResource LightBrush}">
                                        <Binding Path="Colour" />
                                        <Binding Path="IsLit" />
                                    </MultiBinding>
                                </Ellipse.Fill>
                            </Ellipse>
                            <TextBlock x:Name="label" Text="{Binding Label}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontSize="10" FontWeight="Bold" Foreground="{StaticResource LightOffTextBrush}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsLit}" Value="True">
                                <Setter TargetName="label" Property="Foreground" Value="#E6000000" />
                                <Setter TargetName="face" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="14" ShadowDepth="0" Opacity="0.6" Color="White" />
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsUnconfigured}" Value="True">
                                <Setter TargetName="face" Property="Opacity" Value="0.55" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="selection" Property="Stroke" Value="{StaticResource AccentBrush}" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ItemsPanelTemplate x:Key="HorizontalPanel">
            <StackPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,24,28,28">
            <!-- Header -->
            <DockPanel Margin="0,0,0,18">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding LightTestCommand}" ToolTip="Light every light on the Bravo for 3 seconds">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xEA80;" FontFamily="Segoe MDL2 Assets" Margin="0,2,8,0" />
                            <TextBlock Text="Light test" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Dashboard" Style="{StaticResource H1}" />
                    <TextBlock Text="What the simulator, your Bravo and the active profile are doing right now." Style="{StaticResource Dim}" Margin="0,4,0,0" />
                </StackPanel>
            </DockPanel>

            <!-- Status cards -->
            <Grid Margin="0,0,-12,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource StatusCard}">
                    <StackPanel>
                        <TextBlock Text="SIMULATOR" Style="{StaticResource Label}" />
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="10" Height="10" Margin="0,0,8,0" Fill="{Binding SimStatusLevel, Converter={StaticResource StatusBrush}}" />
                            <TextBlock Text="{Binding SimStatusText}" FontSize="16" FontWeight="SemiBold" />
                        </StackPanel>
                        <TextBlock Text="{Binding SimStatusDetail}" Style="{StaticResource Dim}" FontSize="11.5" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding SimStatusDetail}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource StatusCard}">
                    <StackPanel>
                        <TextBlock Text="HONEYCOMB BRAVO" Style="{StaticResource Label}" />
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="10" Height="10" Margin="0,0,8,0" Fill="{Binding BravoStatusLevel, Converter={StaticResource StatusBrush}}" />
                            <TextBlock Text="{Binding BravoStatusText}" FontSize="16" FontWeight="SemiBold" />
                        </StackPanel>
                        <TextBlock Text="USB throttle quadrant" Style="{StaticResource Dim}" FontSize="11.5" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource StatusCard}">
                    <StackPanel>
                        <TextBlock Text="LVAR MODULE" Style="{StaticResource Label}" />
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="10" Height="10" Margin="0,0,8,0" Fill="{Binding ModuleStatusLevel, Converter={StaticResource StatusBrush}}" />
                            <TextBlock Text="{Binding ModuleStatusText}" FontSize="16" FontWeight="SemiBold" />
                        </StackPanel>
                        <TextBlock Text="{Binding ModuleStatusDetail}" Style="{StaticResource Dim}" FontSize="11.5" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="3" Style="{StaticResource StatusCard}">
                    <StackPanel>
                        <TextBlock Text="BRAVO LIGHTS" Style="{StaticResource Label}" />
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="10" Height="10" Margin="0,0,8,0" Fill="{Binding LightsStatusLevel, Converter={StaticResource StatusBrush}}" />
                            <TextBlock Text="{Binding LightsStatusText}" FontSize="16" FontWeight="SemiBold" />
                        </StackPanel>
                        <TextBlock Text="Lights go out in menus and on exit" Style="{StaticResource Dim}" FontSize="11.5" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Aircraft + profile -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="LOADED AIRCRAFT" Style="{StaticResource Label}" />
                        <TextBlock Text="{Binding AircraftTitle}" Style="{StaticResource H2}" TextWrapping="Wrap" />
                        <Grid Margin="0,10,0,0" Visibility="{Binding HasAircraft, Converter={StaticResource BoolToVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Folder" Foreground="{StaticResource TextDimBrush}" Margin="0,0,12,4" />
                            <TextBox Grid.Column="1" Text="{Binding AircraftFolder, Mode=OneWay}" IsReadOnly="True" FontFamily="{StaticResource MonoFont}"
                                     FontSize="12" Padding="6,2" Margin="0,0,0,4" BorderThickness="0" />
                            <TextBlock Grid.Row="1" Text="Path" Foreground="{StaticResource TextDimBrush}" Margin="0,0,12,0" />
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding AircraftPath, Mode=OneWay}" IsReadOnly="True" FontFamily="{StaticResource MonoFont}"
                                     FontSize="12" Padding="6,2" BorderThickness="0" TextWrapping="Wrap" />
                        </Grid>
                        <TextBlock Margin="0,8,0,0" Style="{StaticResource Dim}" Visibility="{Binding HasAircraft, Converter={StaticResource InvBoolToVis}}"
                                   Text="Load a flight in MSFS 2020 or 2024 and the aircraft will appear here." />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="ACTIVE PROFILE" Style="{StaticResource Label}" />
                        <DockPanel>
                            <Border DockPanel.Dock="Right" Style="{StaticResource Badge}" Background="{StaticResource WarningSoftBrush}"
                                    Visibility="{Binding IsUsingDefaultProfile, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="DEFAULT" FontSize="10" FontWeight="Bold" Foreground="{StaticResource WarningBrush}" />
                            </Border>
                            <TextBlock Text="{Binding ActiveProfileName}" Style="{StaticResource H2}" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                        <TextBlock Text="{Binding MatchExplanation}" Style="{StaticResource Dim}" Margin="0,4,0,10" />

                        <TextBlock Text="Profile to use" Style="{StaticResource Label}" />
                        <ComboBox ItemsSource="{Binding ProfileChoices}" SelectedItem="{Binding SelectedChoice}" DisplayMemberPath="Name" Margin="0,0,0,12" />

                        <WrapPanel>
                            <Button Content="Edit profile" Command="{Binding EditProfileCommand}" Margin="0,0,8,6" />
                            <Button Content="New profile for this aircraft" Command="{Binding CreateProfileForAircraftCommand}" Margin="0,0,8,6" />
                            <Button x:Name="AssignButton" Content="Use a profile for this aircraft ▾" Margin="0,0,8,6" Click="AssignButton_Click"
                                    IsEnabled="{Binding HasAircraft}"
                                    ToolTip="Adds this aircraft to an existing profile, so it's chosen automatically from now on">
                                <Button.ContextMenu>
                                    <ContextMenu ItemsSource="{Binding AssignableProfiles}">
                                        <ContextMenu.ItemContainerStyle>
                                            <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                                <Setter Property="Header" Value="{Binding Name}" />
                                                <Setter Property="Command" Value="{Binding DataContext.AssignAircraftCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                <Setter Property="CommandParameter" Value="{Binding}" />
                                            </Style>
                                        </ContextMenu.ItemContainerStyle>
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Bravo + detail -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Style="{StaticResource Card}" Padding="20">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,14">
                            <TextBlock DockPanel.Dock="Right" Text="Click a light for details" Style="{StaticResource Dim}" FontSize="11.5" VerticalAlignment="Center" />
                            <TextBlock Text="BRAVO LIGHTS" Style="{StaticResource Label}" Margin="0" />
                        </DockPanel>

                        <!-- Autopilot buttons -->
                        <ItemsControl ItemsSource="{Binding AutopilotTiles}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource LightTileButton}" Height="40" Margin="4" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Gear -->
                            <Border Background="{StaticResource Surface2Brush}" CornerRadius="8" Padding="14,12">
                                <StackPanel>
                                    <TextBlock Text="GEAR" Style="{StaticResource Label}" HorizontalAlignment="Center" />
                                    <ItemsControl ItemsSource="{Binding GearRedTiles}" ItemsPanel="{StaticResource HorizontalPanel}" Margin="0,4,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource GearLightButton}" Margin="5" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <ItemsControl ItemsSource="{Binding GearGreenTiles}" ItemsPanel="{StaticResource HorizontalPanel}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource GearLightButton}" Margin="5" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- Annunciator panel -->
                            <Border Grid.Column="2" Background="#FF0B0D11" CornerRadius="8" Padding="8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                <StackPanel>
                                    <ItemsControl ItemsSource="{Binding WarningTiles}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Rows="1" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource LightTileButton}" Height="44" Margin="3" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <ItemsControl ItemsSource="{Binding CautionTiles}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Rows="1" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource LightTileButton}" Height="44" Margin="3" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Ellipse Width="7" Height="7" Fill="{StaticResource DangerBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="expression error" Style="{StaticResource Dim}" FontSize="11.5" Margin="0,0,16,0" />
                            <Border Width="14" Height="10" CornerRadius="2" Background="{StaticResource LightOffBrush}" Opacity="0.55" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="not configured" Style="{StaticResource Dim}" FontSize="11.5" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Selected light detail -->
                <Border Grid.Row="2" Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="SELECTED LIGHT" Style="{StaticResource Label}" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource SmallButton}" Content="Edit in profile" Command="{Binding EditLightCommand}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding SelectedLight.Info.Label}" Style="{StaticResource H2}" />
                        </DockPanel>
                        <TextBlock Text="{Binding SelectedSource}" Style="{StaticResource Dim}" Margin="0,2,0,10" />

                        <TextBlock Text="Expression" Style="{StaticResource Label}" />
                        <Border Background="{StaticResource BgBrush}" CornerRadius="6" Padding="10,8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <TextBox Text="{Binding SelectedExpression, Mode=OneWay}" IsReadOnly="True" Background="Transparent" BorderThickness="0" Padding="0"
                                     FontFamily="{StaticResource MonoFont}" FontSize="12" TextWrapping="Wrap" />
                        </Border>
                        <TextBlock Text="Inverted: lit when the expression is false" Foreground="{StaticResource WarningBrush}" Margin="0,4,0,0" FontSize="11.5"
                                   Visibility="{Binding SelectedInvert, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Text="{Binding SelectedError}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Visibility="{Binding SelectedError, Converter={StaticResource NullToVis}}" />
                        <TextBlock Text="{Binding SelectedNote}" Style="{StaticResource Dim}" FontStyle="Italic" Margin="0,6,0,0"
                                   Visibility="{Binding SelectedNote, Converter={StaticResource NullToVis}}" />

                        <TextBlock Text="Master enable (applies to every light)" Style="{StaticResource Label}" Margin="0,12,0,4" />
                        <TextBlock Text="{Binding MasterEnableText}" Style="{StaticResource Mono}" Foreground="{StaticResource TextDimBrush}" TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="LIVE VALUES" Style="{StaticResource Label}" />
                        <TextBlock Text="Every variable this light depends on, including master enable." Style="{StaticResource Dim}" FontSize="11.5" Margin="0,0,0,8" />
                        <ItemsControl ItemsSource="{Binding Monitor.Variables}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource Mono}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" Margin="0,0,10,0" />
                                        <TextBlock Grid.Column="1" Text="{Binding ValueText}" Style="{StaticResource Mono}" MaxWidth="220" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding ValueText}">
                                            <TextBlock.Foreground>
                                                <Binding Path="IsError">
                                                    <Binding.Converter>
                                                        <ui:BoolToBrushConverter TrueBrush="{StaticResource DangerBrush}" FalseBrush="{StaticResource SuccessBrush}" />
                                                    </Binding.Converter>
                                                </Binding>
                                            </TextBlock.Foreground>
                                        </TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="This light doesn't use any variables." Style="{StaticResource Dim}" FontSize="11.5"
                                   Visibility="{Binding Monitor.Variables.Count, Converter={StaticResource ZeroToVis}, FallbackValue=Visible}" />
                    </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
