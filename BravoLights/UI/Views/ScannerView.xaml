<UserControl x:Class="BravoLights.UI.Views.ScannerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:BravoLights.UI.ViewModels"
             xmlns:Behaviors="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:views="clr-namespace:BravoLights.UI.Views"
             xmlns:ui="clr-namespace:BravoLights.UI"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ScannerViewModel}"
             d:DesignWidth="980" d:DesignHeight="800">
    <UserControl.Resources>
        <!-- Context menu for a variable row. Its DataContext is the row's ScanItem. -->
        <ContextMenu x:Key="RowMenu" x:Shared="False">
            <MenuItem Header="Copy name" Click="CopyName_Click" />
            <MenuItem Header="Copy as condition" Click="CopyCondition_Click" />
            <Separator />
            <MenuItem Header="Add to light in target profile" ItemsSource="{x:Static ui:LightCatalog.All}" Click="AddToLight_Click">
                <MenuItem.ItemContainerStyle>
                    <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                        <Setter Property="Header" Value="{Binding Label}" />
                    </Style>
                </MenuItem.ItemContainerStyle>
            </MenuItem>
        </ContextMenu>
    </UserControl.Resources>
    <DockPanel Margin="28,24,28,24">
        <!-- Header -->
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Variable scanner" Style="{StaticResource H1}" />
            <TextBlock Style="{StaticResource Dim}" Margin="0,4,0,14" Text="{Binding StatusText}" />

            <!-- How-to -->
            <Border Style="{StaticResource Card}" Padding="14,10" Margin="0,0,0,14">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Text="&#xE82F;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{StaticResource WarningBrush}" Margin="0,2,12,0" VerticalAlignment="Top" />
                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextDimBrush}">
                        <Run Foreground="{StaticResource TextBrush}" FontWeight="SemiBold">Find the variable behind a cockpit light:</Run>
                        turn on <Run Foreground="{StaticResource TextBrush}">Watch all</Run>, wait a few seconds and press
                        <Run Foreground="{StaticResource TextBrush}">Mute noisy</Run> (hides timers and animations), then turn on
                        <Run Foreground="{StaticResource TextBrush}">Only changed</Run> and operate the switch or wait for the annunciator in the cockpit.
                        The variables that change are your candidates. Right-click one to add it to a light.
                    </TextBlock>
                </DockPanel>
            </Border>

            <!-- Toolbar -->
            <DockPanel Margin="0,0,0,10">
                <Border DockPanel.Dock="Left" Background="{StaticResource Surface2Brush}" CornerRadius="6" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource SegmentItem}" GroupName="scanKind" IsChecked="{Binding ShowLVars}" Content="L: variables" />
                        <RadioButton Style="{StaticResource SegmentItem}" GroupName="scanKind" IsChecked="{Binding ShowSimVars}" Content="A: variables" />
                    </StackPanel>
                </Border>
                <Button DockPanel.Dock="Right" Command="{Binding RefreshListCommand}" Margin="6,0,0,0" ToolTip="Ask the simulator for its LVar list again">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" Margin="0,2,6,0" />
                        <TextBlock Text="Reload list" />
                    </StackPanel>
                </Button>
                <Grid>
                    <TextBox x:Name="SearchBox" Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged, Delay=200}" />
                    <TextBlock Text="Filter by name (several words narrow it down), e.g. GEAR LIGHT" Foreground="{StaticResource TextFaintBrush}" IsHitTestVisible="False"
                               Margin="10,0,0,0" VerticalAlignment="Center" Visibility="{Binding Text, ElementName=SearchBox, Converter={StaticResource InvNullToVis}}" />
                </Grid>
            </DockPanel>

            <WrapPanel Margin="0,0,0,10">
                <ToggleButton Content="Watch all" IsChecked="{Binding WatchAll}" Margin="0,0,6,0" IsEnabled="{Binding ShowLVars}"
                              ToolTip="Subscribe to every LVar so changes can be detected anywhere in the list (uses a little more simulator time)" />
                <Button Content="Mute noisy" Command="{Binding MuteNoisyCommand}" Margin="0,0,6,0"
                        ToolTip="Hide every variable that has changed so far (e.g. timers), then take a snapshot" />
                <ToggleButton Content="Only changed" IsChecked="{Binding OnlyChanged}" Margin="0,0,6,0"
                              ToolTip="Show only variables that have changed since the last snapshot" />
                <Button Content="Snapshot" Command="{Binding SnapshotCommand}" Margin="0,0,6,0"
                        ToolTip="Take the current values as the baseline and clear the change counts" />
                <Button Content="Unmute all" Command="{Binding UnmuteAllCommand}" Margin="0,0,6,0" />
            </WrapPanel>

            <DockPanel Margin="0,0,0,8">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <TextBlock Text="Add variables to profile" VerticalAlignment="Center" Foreground="{StaticResource TextDimBrush}" Margin="0,0,8,0" />
                    <ComboBox ItemsSource="{Binding Targets}" SelectedItem="{Binding SelectedTarget}" DisplayMemberPath="Name" Width="260" />
                </StackPanel>
                <TextBlock VerticalAlignment="Center" Foreground="{StaticResource TextDimBrush}">
                    <Run Text="{Binding VisibleCount, Mode=OneWay}" /> shown ·
                    <Run Text="{Binding ChangedCount, Mode=OneWay}" /> changed since snapshot
                </TextBlock>
            </DockPanel>
        </StackPanel>

        <DataGrid x:Name="Grid" ItemsSource="{Binding ItemsView}" LoadingRow="Grid_LoadingRow" UnloadingRow="Grid_UnloadingRow"
                  CanUserSortColumns="True" FontSize="12.5">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                    <Setter Property="ContextMenu" Value="{StaticResource RowMenu}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Muted}" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource TextFaintBrush}" />
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource HoverBrush}" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="NAME" Binding="{Binding Name}" Width="2*" SortMemberPath="Name">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                            <Setter Property="ToolTip" Value="{Binding Description}" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="UNITS" Binding="{Binding Units}" Width="90" Visibility="Visible" />
                <DataGridTemplateColumn Header="VALUE" Width="*" SortMemberPath="NumericValue">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding ValueText}" FontFamily="{StaticResource MonoFont}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ValueText}">
                                <Behaviors:Interaction.Behaviors>
                                    <views:HighlightValueChangeBehavior />
                                </Behaviors:Interaction.Behaviors>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="SNAPSHOT" Binding="{Binding BaselineText}" Width="100">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
                            <Setter Property="Foreground" Value="{StaticResource TextDimBrush}" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="CHANGES" Binding="{Binding ChangeCount}" Width="80" SortMemberPath="ChangeCount" />
                <DataGridTextColumn Header="LAST CHANGE" Binding="{Binding LastChangedText}" Width="100" SortMemberPath="LastChanged" />
                <DataGridTextColumn Header="DESCRIPTION" Binding="{Binding Description}" Width="2*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource TextDimBrush}" />
                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                            <Setter Property="ToolTip" Value="{Binding Description}" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
