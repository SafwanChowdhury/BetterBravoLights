<UserControl x:Class="BravoLights.UI.Views.ScannerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:BravoLights.UI.ViewModels"
             xmlns:Behaviors="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:views="clr-namespace:BravoLights.UI.Views"
             xmlns:ui="clr-namespace:BravoLights.UI"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ScannerViewModel}"
             d:DesignWidth="1000" d:DesignHeight="800">
    <UserControl.Resources>
        <!-- Context menu for a variable row. Its DataContext is the row's ScanItem. -->
        <ContextMenu x:Key="RowMenu" x:Shared="False">
            <MenuItem Header="Copy name" Click="CopyName_Click" />
            <MenuItem Header="Copy as condition" Click="CopyCondition_Click" />
            <Separator />
            <MenuItem Header="Add to light in target profile" ItemsSource="{x:Static ui:LightCatalog.All}" Click="AddToLight_Click">
                <MenuItem.ItemContainerStyle>
                    <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                        <Setter Property="Header" Value="{Binding Label}" />
                    </Style>
                </MenuItem.ItemContainerStyle>
            </MenuItem>
        </ContextMenu>

        <Style x:Key="StepNumber" TargetType="Border">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="StepText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,22,0" />
        </Style>
    </UserControl.Resources>

    <DockPanel Margin="36,30,36,24">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Variables" Style="{StaticResource H1}" />
            <TextBlock Style="{StaticResource Dim}" Margin="0,4,0,18" Text="{Binding StatusText}" />

            <!-- How to find the variable behind a cockpit light -->
            <WrapPanel Margin="0,0,0,18">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <Border Style="{StaticResource StepNumber}"><TextBlock Text="1" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                    <TextBlock Style="{StaticResource StepText}" Text="Watch all" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <Border Style="{StaticResource StepNumber}"><TextBlock Text="2" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                    <TextBlock Style="{StaticResource StepText}" Text="Wait a moment, then Mute noisy" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <Border Style="{StaticResource StepNumber}"><TextBlock Text="3" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                    <TextBlock Style="{StaticResource StepText}" Text="Only changed" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <Border Style="{StaticResource StepNumber}"><TextBlock Text="4" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                    <TextBlock Style="{StaticResource StepText}" Text="Flip the switch in the cockpit; right-click a result to use it" />
                </StackPanel>
            </WrapPanel>

            <!-- Search and source -->
            <DockPanel Margin="0,0,0,12">
                <Border DockPanel.Dock="Left" Style="{StaticResource Segment}" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource SegmentItem}" GroupName="scanKind" IsChecked="{Binding ShowLVars}" Content="L: variables" />
                        <RadioButton Style="{StaticResource SegmentItem}" GroupName="scanKind" IsChecked="{Binding ShowSimVars}" Content="A: variables" />
                    </StackPanel>
                </Border>
                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE72C;" Command="{Binding RefreshListCommand}" Margin="6,0,0,0"
                        ToolTip="Ask the simulator for its LVar list again" />
                <Grid>
                    <TextBox x:Name="SearchBox" Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged, Delay=200}" Padding="32,7,10,7" />
                    <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" FontSize="12" Foreground="{DynamicResource TextFaintBrush}" Margin="12,0,0,0"
                               HorizontalAlignment="Left" IsHitTestVisible="False" />
                    <TextBlock Text="Filter by name, e.g. GEAR LIGHT" Style="{StaticResource Placeholder}" Margin="33,0,0,0"
                               Visibility="{Binding Text, ElementName=SearchBox, Converter={StaticResource InvNullToVis}}" />
                </Grid>
            </DockPanel>

            <!-- Change detection -->
            <DockPanel Margin="0,0,0,12">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <TextBlock Text="Target profile" VerticalAlignment="Center" Foreground="{DynamicResource TextDimBrush}" Margin="0,0,10,0" />
                    <ComboBox ItemsSource="{Binding Targets}" SelectedItem="{Binding SelectedTarget}" DisplayMemberPath="Name" Width="240"
                              ToolTip="Variables you add to a light from the right-click menu go into this profile" />
                </StackPanel>
                <WrapPanel>
                    <ToggleButton Content="Watch all" IsChecked="{Binding WatchAll}" Margin="0,0,6,0" IsEnabled="{Binding ShowLVars}"
                                  ToolTip="Subscribe to every LVar so changes can be detected anywhere in the list" />
                    <Button Content="Mute noisy" Command="{Binding MuteNoisyCommand}" Margin="0,0,6,0" Style="{StaticResource GhostButton}"
                            ToolTip="Hide every variable that has changed so far (timers, animations…), then take a snapshot" />
                    <ToggleButton Content="Only changed" IsChecked="{Binding OnlyChanged}" Margin="0,0,6,0"
                                  ToolTip="Show only variables that have changed since the last snapshot" />
                    <Button Content="Snapshot" Command="{Binding SnapshotCommand}" Margin="0,0,6,0" Style="{StaticResource GhostButton}"
                            ToolTip="Take the current values as the baseline and clear the change counts" />
                    <Button Content="Unmute all" Command="{Binding UnmuteAllCommand}" Style="{StaticResource GhostButton}" />
                </WrapPanel>
            </DockPanel>
        </StackPanel>

        <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Faint}" Margin="4,10,0,0">
            <Run Text="{Binding VisibleCount, Mode=OneWay}" /> shown · <Run Text="{Binding ChangedCount, Mode=OneWay}" /> changed since snapshot
        </TextBlock>

        <Border Style="{StaticResource Card}" Padding="6,4">
            <DataGrid x:Name="Grid" ItemsSource="{Binding ItemsView}" LoadingRow="Grid_LoadingRow" UnloadingRow="Grid_UnloadingRow"
                      CanUserSortColumns="True" FontSize="12.5">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                        <Setter Property="ContextMenu" Value="{StaticResource RowMenu}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Muted}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*" SortMemberPath="Name">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
                                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                <Setter Property="ToolTip" Value="{Binding Description}" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Units" Binding="{Binding Units}" Width="90">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}" />
                                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTemplateColumn Header="Value" Width="*" SortMemberPath="NumericValue">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding ValueText}" FontFamily="{StaticResource MonoFont}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ValueText}"
                                           Padding="4,1">
                                    <Behaviors:Interaction.Behaviors>
                                        <views:HighlightValueChangeBehavior />
                                    </Behaviors:Interaction.Behaviors>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Snapshot" Binding="{Binding BaselineText}" Width="100">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Changes" Binding="{Binding ChangeCount}" Width="80" SortMemberPath="ChangeCount" />
                    <DataGridTextColumn Header="Last change" Binding="{Binding LastChangedText}" Width="100" SortMemberPath="LastChanged">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="2*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}" />
                                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                <Setter Property="ToolTip" Value="{Binding Description}" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </DockPanel>
</UserControl>
