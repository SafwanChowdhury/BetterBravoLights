<UserControl x:Class="BravoLights.UI.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:BravoLights.UI.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
             d:DesignWidth="980" d:DesignHeight="800">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,24,28,28" MaxWidth="980" HorizontalAlignment="Left">
            <TextBlock Text="Settings" Style="{StaticResource H1}" />
            <TextBlock Text="Install Better Bravo Lights into your simulators and adjust how it behaves." Style="{StaticResource Dim}" Margin="0,4,0,18" />

            <!-- Simulators -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <DockPanel Margin="0,0,0,6">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="Refresh" Command="{Binding RefreshCommand}" Margin="0,0,8,0" />
                            <Button Content="Install into all" Style="{StaticResource PrimaryButton}" Command="{Binding InstallAllCommand}" />
                        </StackPanel>
                        <TextBlock Text="Simulators" Style="{StaticResource H2}" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource Dim}" Margin="0,0,0,12"
                               Text="Installing adds Better Bravo Lights to the simulator's exe.xml so it starts automatically, and copies the WASM module (needed to read L: variables) into the Community folder. MSFS 2020 and MSFS 2024 are installed separately." />

                    <TextBlock Text="No installation of MSFS 2020 or MSFS 2024 was found for this Windows user." Foreground="{StaticResource WarningBrush}"
                               Visibility="{Binding NoSimsFound, Converter={StaticResource BoolToVis}}" />

                    <ItemsControl ItemsSource="{Binding Sims}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource Surface2Brush}" CornerRadius="8" Padding="14,12" Margin="0,0,0,10">
                                    <StackPanel>
                                        <DockPanel>
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                                <Button Style="{StaticResource SmallButton}" Content="Install / repair" Command="{Binding InstallCommand}" Margin="0,0,6,0" />
                                                <Button Style="{StaticResource SmallButton}" Content="Update WASM only" Command="{Binding InstallWasmCommand}" Margin="0,0,6,0" />
                                                <Button Style="{StaticResource SmallButton}" Content="Uninstall" Command="{Binding UninstallCommand}" Foreground="{StaticResource DangerBrush}" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" />
                                                <Border Style="{StaticResource Badge}" Background="{StaticResource SuccessSoftBrush}" Margin="10,0,0,0"
                                                        Visibility="{Binding IsFullyInstalled, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="INSTALLED" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" />
                                                </Border>
                                            </StackPanel>
                                        </DockPanel>

                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                            <Ellipse Width="8" Height="8" Margin="0,0,8,0" Fill="{Binding AutoStartLevel, Converter={StaticResource StatusBrush}}" />
                                            <TextBlock Text="{Binding AutoStartText}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <Ellipse Width="8" Height="8" Margin="0,0,8,0" Fill="{Binding WasmLevel, Converter={StaticResource StatusBrush}}" />
                                            <TextBlock Text="{Binding WasmText}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Problem}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="0,6,0,0"
                                                   Visibility="{Binding Problem, Converter={StaticResource NullToVis}}" />
                                        <TextBlock Text="{Binding SharedNote}" Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap" Margin="0,6,0,0"
                                                   Visibility="{Binding SharedNote, Converter={StaticResource NullToVis}}" />

                                        <Grid Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition />
                                                <RowDefinition />
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="Settings folder" Foreground="{StaticResource TextDimBrush}" Margin="0,0,12,4" FontSize="12" />
                                            <TextBlock Grid.Column="1" Text="{Binding ConfigFolder}" FontFamily="{StaticResource MonoFont}" FontSize="11.5" TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding ConfigFolder}" VerticalAlignment="Center" />
                                            <Button Grid.Column="2" Style="{StaticResource GhostButton}" Content="Open" Command="{Binding OpenConfigCommand}" FontSize="12" />
                                            <TextBlock Grid.Row="1" Text="Community folder" Foreground="{StaticResource TextDimBrush}" Margin="0,0,12,0" FontSize="12" />
                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CommunityPath}" FontFamily="{StaticResource MonoFont}" FontSize="11.5"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding CommunityPath}" VerticalAlignment="Center" />
                                            <Button Grid.Row="1" Grid.Column="2" Style="{StaticResource GhostButton}" Content="Open" Command="{Binding OpenCommunityCommand}" FontSize="12" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Behaviour -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Behaviour" Style="{StaticResource H2}" Margin="0,0,0,12" />
                    <CheckBox Content="Exit when the simulator exits" IsChecked="{Binding ExitWithSimulator}" Margin="0,0,0,10" />
                    <CheckBox Content="Open this window when Better Bravo Lights is started manually" IsChecked="{Binding ShowWindowOnManualStart}" Margin="0,0,0,10" />
                    <CheckBox Content="Keep this window on top of other windows" IsChecked="{Binding AlwaysOnTop}" Margin="0,0,0,10" />
                    <CheckBox Content="Check for new versions" IsChecked="{Binding CheckForUpdates}" />
                    <TextBlock Style="{StaticResource Dim}" Margin="0,10,0,0" Text="When the simulator starts Better Bravo Lights it runs quietly in the notification area; double-click its icon to open this window." />
                </StackPanel>
            </Border>

            <!-- Profiles & data -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Profiles and data" Style="{StaticResource H2}" Margin="0,0,0,12" />
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Profiles folder" Foreground="{StaticResource TextDimBrush}" Margin="0,0,12,6" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding ProfilesFolder}" FontFamily="{StaticResource MonoFont}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <Button Grid.Column="2" Style="{StaticResource SmallButton}" Content="Open" Command="{Binding OpenProfilesFolderCommand}" Margin="8,0,0,6" />
                        <TextBlock Grid.Row="1" Text="Program and logs" Foreground="{StaticResource TextDimBrush}" Margin="0,0,12,0" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ProgramFolder}" FontFamily="{StaticResource MonoFont}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <Button Grid.Row="1" Grid.Column="2" Style="{StaticResource SmallButton}" Content="Open" Command="{Binding OpenLogsFolderCommand}" Margin="8,0,0,0" />
                    </Grid>
                    <TextBlock Style="{StaticResource Dim}" Margin="0,0,0,10"
                               Text="Each profile is a separate .bblprofile file. You can share them, back them up, or edit them by hand; changes are picked up automatically." />
                    <WrapPanel>
                        <Button Content="Import old Config.ini…" Command="{Binding ImportLegacyCommand}" Margin="0,0,8,0"
                                ToolTip="Convert the [Aircraft.xxx] sections of an old Better Bravo Lights configuration into profiles" />
                        <Button Content="Restore built-in profiles" Command="{Binding RestoreTemplatesCommand}"
                                ToolTip="Add back any built-in aircraft profiles you've deleted" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- About -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="About" Style="{StaticResource H2}" Margin="0,0,0,8" />
                    <TextBlock Text="{Binding Version}" />
                    <TextBlock Text="{Binding UpdateText}" Foreground="{StaticResource AccentBrush}" Margin="0,4,0,0" Visibility="{Binding UpdateText, Converter={StaticResource NullToVis}}" />
                    <TextBlock Style="{StaticResource Dim}" Margin="0,6,0,10"
                               Text="Originally by Royston Shufflebotham. Supports Microsoft Flight Simulator 2020 and 2024 with the Honeycomb Bravo Throttle Quadrant." />
                    <Button HorizontalAlignment="Left" Content="Documentation" Command="{Binding OpenWebsiteCommand}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
