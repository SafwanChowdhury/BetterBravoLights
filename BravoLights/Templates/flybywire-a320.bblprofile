{
  "format": "BetterBravoLights.Profile",
  "version": 1,
  "id": "flybywire-a320",
  "name": "FlyByWire A320",
  "enabled": true,
  "aircraft": [
    "FlyByWire_A320_NEO"
  ],
  "inheritDefault": true,
  "masterEnable": "L:A32NX_ELEC_AC_ESS_BUS_IS_POWERED == 1",
  "lights": {
    "AUTOPILOT": {
      "expression": "L:A32NX_AUTOPILOT_1_ACTIVE == 1 OR L:A32NX_AUTOPILOT_2_ACTIVE == 1",
      "note": "A320 FBW has two autopilots, specific to FBW"
    },
    "StarterEngaged": {
      "expression": "A:TURB ENG IGNITION SWITCH EX1:1, bool == 2",
      "note": "On the A320 the starter switch is 'TURB ENG IGNITION SWITCH EX1:n' (the master engine switches are 'GENERAL ENG STARTER:n')"
    },
    "APU": {
      "expression": "A:APU GENERATOR ACTIVE, bool == 1",
      "note": "Don't check for APU GENERATOR SWITCH. It always reports '1'"
    },
    "LowHydPressure": {
      "expression": "L:A32NX_HYD_BLUE_SYSTEM_1_SECTION_PRESSURE < 2000 OR L:A32NX_HYD_GREEN_SYSTEM_1_SECTION_PRESSURE < 2000 OR L:A32NX_HYD_YELLOW_SYSTEM_1_SECTION_PRESSURE < 2000",
      "note": "FBW provides custom LVARS for the 3 hydraulic systems"
    },
    "ParkingBrake": {
      "expression": "L:A32NX_PARK_BRAKE_LEVER_POS == 1",
      "note": "FBW does not set A:BRAKE PARKING POSITION"
    },
    "LowVolts": {
      "expression": "A:ELECTRICAL MAIN BUS VOLTAGE, volts < 24",
      "note": "From flybywire-aircraft-a320-neo\\html_ui\\Pages\\VCockpit\\Instruments\\NavSystems\\A320_Neo\\A32NX_NavSystem.js"
    },
    "LowFuelPressure": {
      "expression": "A:GENERAL ENG FUEL PRESSURE:1, psi <= 10 OR A:GENERAL ENG FUEL PRESSURE:2, psi <= 10"
    },
    "LowOilPressure": {
      "expression": "A:ENG OIL PRESSURE:1, psi <= 60 OR A:ENG OIL PRESSURE:2, psi <= 60",
      "note": "From flybywire-aircraft-a320-neo\\html_ui\\Pages\\VCockpit\\Instruments\\NavSystems\\A320_Neo\\A32NX_NavSystem.js"
    },
    "Door": {
      "expression": "A:CANOPY OPEN, percent > 0 OR A:EXIT OPEN:0, percent > 0 OR A:INTERACTIVE POINT OPEN:3, percent > 0 OR A:INTERACTIVE POINT OPEN:5, percent > 0",
      "note": "Monitor front and rear and cargo doors From flybywire-aircraft-a320-neo\\html_ui\\Pages\\A32NX_Core\\A32NX_LocalVarUpdater.js"
    },
    "AntiIce": {
      "expression": "A:STRUCTURAL DEICE SWITCH, bool == 1 OR A:ENG ANTI ICE:1, bool == 1 OR A:ENG ANTI ICE:2, bool == 1 OR L:A32NX_MAN_PITOT_HEAT == 1",
      "note": "Equivalent of stock A320 but with A:PITOT HEAT, bool replaced with L:A32NX_MAN_PITOT_HEAT A320 is different from GA aircraft in that we show when an Anti-Ice system is _enabled_ rather than when it isn't"
    },
    "APR": {
      "expression": "L:A32NX_FCU_APPR_MODE_ACTIVE == 1",
      "note": "Many thanks to BJ1960 for contributing to these Details: https://github.com/RoystonS/BetterBravoLights/issues/33 ?? HDG = L:A32NX_FCU_HDG_MANAGED_DOT == 0 ?? NAV = L:A32NX_FCU_HDG_MANAGED_DOT == 1"
    },
    "ALT": {
      "expression": "A:AUTOPILOT ALTITUDE SLOT INDEX, bool == 2"
    },
    "VS": {
      "expression": "L:A32NX_AUTOPILOT_VS_SELECTED == 0"
    }
  }
}