      "expression": "A:FUEL TRANSFER PUMP ON:1, bool == 1 && A:FUEL SELECTED TRANSFER MODE, enum == 5",
      "note": "From panel\\panel.xml"
    },
    "LowVolts": {
      "expression": "A:ELECTRICAL MAIN BUS VOLTAGE:3, volts < 25.5",
      "note": "From panel\\panel.xml"
    }
  }
}