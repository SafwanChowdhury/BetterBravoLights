{
  "format": "BetterBravoLights.Profile",
  "version": 1,
  "id": "fenix-a32x",
  "name": "Fenix A319/A320/A321",
  "enabled": true,
  "aircraft": [
    "FNX_32X",
    "fnx320"
  ],
  "inheritDefault": true,
  "masterEnable": "L:S_OH_ELEC_BAT1 == 1 OR L:S_OH_ELEC_BAT2 == 1",
  "lights": {
    "GearLGreen": {
      "expression": "L:I_MIP_GEAR_1_L == 1"
    },
    "GearLRed": {
      "expression": "L:I_MIP_GEAR_1_U == 1 AND L:I_MIP_GEAR_1_L == 0"
    },
    "GearCGreen": {
      "expression": "L:I_MIP_GEAR_2_L == 1"
    },
    "GearCRed": {
      "expression": "L:I_MIP_GEAR_2_U == 1  AND L:I_MIP_GEAR_2_L == 0"
    },
    "GearRGreen": {
      "expression": "L:I_MIP_GEAR_3_L == 1"
    },
    "GearRRed": {
      "expression": "L:I_MIP_GEAR_3_U == 1 AND L:I_MIP_GEAR_3_L == 0"
    },
    "MasterCaution": {
      "expression": "L:I_MIP_MASTER_CAUTION_CAPT == 1"
    },
    "MasterWarning": {
      "expression": "L:I_MIP_MASTER_WARNING_CAPT == 1"
    },
    "StarterEngaged": {
      "expression": "L:S_ENG_MODE == 0 OR L:S_ENG_MODE == 2"
    },
    "EngineFire": {
      "expression": "L:I_OH_FIRE_ENG1_BUTTON == 1 OR L:I_OH_FIRE_ENG2_BUTTON == 1 OR L:I_OH_FIRE_APU_BUTTON == 1"
    },
    "AntiIce": {
      "expression": "L:I_OH_PNEUMATIC_ENG1_ANTI_ICE_L == 1 OR L:I_OH_PNEUMATIC_ENG2_ANTI_ICE_L == 1 OR L:I_OH_PNEUMATIC_WING_ANTI_ICE_L == 1"
    },
    "Door": {
      "expression": "L:A320_door_0 > 0 OR L:A320_door_1 > 0 OR L:A320_door_2 > 0 OR L:A320_door_3 > 0 OR L:A320_door_4 > 0 OR L:A320_door_5 > 0"
    },
    "APU": {
      "expression": "L:I_OH_ELEC_APU_START_U == 1",
      "note": "AVAIL is illuminated"
    },
    "LowVolts": {
      "expression": "L:I_OH_ELEC_GEN1_U == 1 AND L:I_OH_ELEC_GEN2_U == 1 AND L:I_OH_ELEC_EXT_PWR_L == 0 AND L:I_OH_ELEC_APU_START_U == 0",
      "note": "Aircraft is running on battery power"
    },
    "LowFuelPressure": {
      "expression": "L:I_OH_FUEL_CENTER_1_L == 1 OR L:I_OH_FUEL_CENTER_1_U == 1 OR L:I_OH_FUEL_CENTER_2_L == 1 OR L:I_OH_FUEL_CENTER_2_U == 1 OR L:I_OH_FUEL_LEFT_1_L == 1 OR L:I_OH_FUEL_LEFT_1_U == 1 OR L:I_OH_FUEL_LEFT_2_L == 1 OR L:I_OH_FUEL_LEFT_2_U == 1 OR L:I_OH_FUEL_RIGHT_1_L == 1 OR L:I_OH_FUEL_RIGHT_1_U == 1 OR L:I_OH_FUEL_RIGHT_2_L == 1 OR L:I_OH_FUEL_RIGHT_2_U == 1",
      "note": "ANY of the fuel pumps are OFF or FAULT"
    },
    "LowHydPressure": {
      "expression": "L:I_OH_HYD_ENG_1_PUMP_L == 1 OR L:I_OH_HYD_ENG_1_PUMP_U == 1 OR L:I_OH_HYD_ENG_2_PUMP_L == 1 OR L:I_OH_HYD_ENG_2_PUMP_U == 1",
      "note": "Either of the engine hydraulic pumps are OFF or FAULT"
    },
    "Vacuum": {
      "expression": "L:I_OH_PNEUMATIC_PACK_1_L == 1 OR L:I_OH_PNEUMATIC_PACK_1_U == 1 OR L:I_OH_PNEUMATIC_PACK_2_L == 1 OR L:I_OH_PNEUMATIC_PACK_2_U == 1",
      "note": "Pack 1 or 2 OFF or FAULT"
    },
    "AUTOPILOT": {
      "expression": "L:I_FCU_AP1 == 1 OR L:I_FCU_AP2 == 1",
      "note": "Lights"
    },
    "HDG": {
      "expression": "L:I_FCU_HEADING_MANAGED == 1"
    },
    "APR": {
      "expression": "L:I_FCU_APPR == 1",
      "note": "NAV = Nothing found, sorry"
    },
    "ALT": {
      "expression": "L:I_FCU_ALTITUDE_MANAGED == 1",
      "note": "REV = Nothing found, sorry"
    },
    "VS": {
      "expression": "L:S_FCU_VERTICAL_SPEED == 2"
    },
    "IAS": {
      "expression": "L:I_FCU_SPEED_MANAGED == 1"
    }
  }
}
