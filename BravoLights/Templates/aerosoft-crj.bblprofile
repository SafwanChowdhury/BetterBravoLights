      "expression": "A:GEAR CENTER POSITION, percent over 100 >= 1"
    },
    "GearCRed": {
      "expression": "A:GEAR CENTER POSITION, percent over 100 > 0 AND A:GEAR CENTER POSITION, percent over 100 < 1"
    },
    "GearRGreen": {
      "expression": "A:GEAR RIGHT POSITION, percent over 100 >= 1"
    },
    "GearRRed": {
      "expression": "A:GEAR RIGHT POSITION, percent over 100 > 0 AND A:GEAR RIGHT POSITION, percent over 100 < 1"
    },
    "MasterWarning": {
      "expression": "L:ASCRJ_GSC_MASTER_WARN_ON == 1"
    },
    "EngineFire": {
      "expression": "L:ASCRJ_GSC_ENG_FIRE_ON == 1 OR L:ASCRJ_GSF_ENG_FIRE_ON == 1"
    },
    "AntiIce": {
      "expression": "L:ASCRJ_AICE_DETECT_ICE == 1 AND (L:ASCRJ_AICE_PHEAT_L == 0 OR L:ASCRJ_AICE_PHEAT_R == 0)"
    },
    "StarterEngaged": {
      "expression": "L:ASCRJ_ENGS_START_R_ON == 1 OR L:ASCRJ_ENGS_START_L_ON == 1"
