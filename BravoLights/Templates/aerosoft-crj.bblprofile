    "APU": {
      "expression": "L:ASCRJ_APU_STARTSTOP == 1"
    },
    "MasterCaution": {
      "expression": "L:ASCRJ_GSC_MASTER_CAUT_ON == 1"
    },
    "Vacuum": {
      "expression": "OFF"
    },
    "LowHydPressure": {
      "expression": "L:ASCRJ_HYDR_PUMP_1 == 1 OR L:ASCRJ_HYDR_PUMP_2 == 1 OR L:ASCRJ_HYDR_PUMP_3A == 0 OR L:ASCRJ_HYDR_PUMP_3B == 1"
    },
    "AuxFuelPump": {
      "expression": "L:ASCRJ_FUEL_PUMP_L_ON == 1 OR L:ASCRJ_FUEL_PUMP_R_ON == 1"
    },
    "ParkingBrake": {
      "expression": "L:ASCRJ_PARK_BRAKE == 1"
    },
    "LowVolts": {
      "expression": "A:ELECTRICAL MAIN BUS VOLTAGE, volts < 23 AND A:ELECTRICAL MAIN BUS VOLTAGE, volts > 0"
    },
    "Door": {
      "expression": "L:DOOR_MAIN_DOOR_POS > 0 OR L:DOOR_SERVICE_POS > 0 OR L:DOOR_FWD_CARGO_POS > 0 OR L:DOOR_AFT_CARGO_POS > 0"
    }
  }
